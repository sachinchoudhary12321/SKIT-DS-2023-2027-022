# ---------------------------------------------------------------------------
# Crop Care Crop — backend environment template
# Copy to `.env` (cp .env.example .env) and adjust. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=crop-care-backend
APP_VERSION=0.2.0
ENVIRONMENT=local                       # local | development | staging | production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- CORS: comma-separated allowed frontend origins (React / Next.js dev server) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Image uploads ---
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Reserved for later tasks (NOT read by the code yet) ---
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cropcare
# ML_MODEL_DIR=ml_models
# ML_DEVICE=cpu
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
